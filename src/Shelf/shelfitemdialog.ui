  <property name="windowTitle">
   <string>货位硬件控制面板</string>
  </property>
  <property name="styleSheet">
   <string>
QDialog { background-color: #f3f4f6; }
QLabel { color: #1f2937; font-family: &quot;Microsoft YaHei&quot;, sans-serif; }
QLineEdit { min-height: 32px; border: 1px solid #d1d5db; border-radius: 4px; padding-left: 8px; background-color: #ffffff; color: #111827; font-size: 13px; }
QLineEdit:focus { border-color: #3b82f6; }
QSpinBox { min-height: 32px; font-size: 13px; }

/* 默认通用按钮样式 (包含修改、执行校准、取消等) */
QPushButton { min-height: 32px; border-radius: 4px; font-weight: bold; font-family: &quot;Microsoft YaHei&quot;, sans-serif; padding: 0 10px; background-color: #ffffff; color: #111827; border: 1px solid #d1d5db; }
QPushButton:hover { background-color: #f9fafb; }
QPushButton:pressed { background-color: #e5e7eb; border-color: #9ca3af; }

/* 底部保存并应用按钮 */
QPushButton#btn_save_db { background-color: #3b82f6; color: #ffffff; border: none; font-size: 14px; }
QPushButton#btn_save_db:hover { background-color: #2563eb; }
QPushButton#btn_save_db:pressed { background-color: #1d4ed8; }

/* 下发计划按钮 */
QPushButton#btnUpdatePlanQty { background-color: #10b981; color: #ffffff; border: none; }
QPushButton#btnUpdatePlanQty:hover { background-color: #059669; }
QPushButton#btnUpdatePlanQty:pressed { background-color: #047857; }

/* 结束(清零)按钮 */
QPushButton#btnClearOperation { background-color: #ef4444; color: #ffffff; border: none; }
QPushButton#btnClearOperation:hover { background-color: #dc2626; }
QPushButton#btnClearOperation:pressed { background-color: #b91c1c; }
   </string>
